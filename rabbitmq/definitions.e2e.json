      "vhost": "ts-system",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],

  "queues": [
    {
      "name": "notification.request.queue",
      "vhost": "ts-system",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
